# === Local tooling ===
.claude/

# === Supabase CLI local cache ===
supabase/.temp/
supabase/.branches/

# === Dependencies & build ===
node_modules/
.pnpm-store/
dist/
# apps/kiosk/build/ é majoritariamente gerado (icon.ico via `pnpm icons`),
# mas installer.nsh é código-fonte do instalador (regra de firewall da
# porta 7317, ver electron-builder.yml) e precisa ficar versionado.
build/
!apps/kiosk/build/
apps/kiosk/build/*
!apps/kiosk/build/installer.nsh
out/
release/
.turbo/
*.tsbuildinfo

# === Electron packaging ===
apps/kiosk/dist/
apps/kiosk/out/
apps/kiosk/release/
apps/kiosk/bundle/
*.exe
*.msi
*.dmg
*.AppImage
*.blockmap

# === Auto-updater feed (artefatos gerados por scripts/release-kiosk.mjs) ===
apps/kiosk/update-feed/kiosk/

# === Env / secrets ===
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.certs/

# === Local databases ===
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
!**/seed/*.sqlite

# === Logs ===
*.log
npm-debug.log*
pnpm-debug.log*

# === OS / editor ===
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# === Coverage / test artifacts ===
coverage/
.nyc_output/

# === Business assets: large binaries kept out of git history ===
# Vídeos e material bruto de marketing/negócio — não pertencem ao
# histórico do código. Mantidos no disco, versionados fora do git
# (Drive/backup próprio) ou movidos para Git LFS se precisarem entrar.
*.mp4
*.mov
*.mkv
*.avi

# Arquivos .gdoc/.gsheet são apenas ponteiros do Google Drive, sem
# conteúdo — inofensivos de versionar, mas não fazem sentido em diffs.
# Mantidos fora por padrão; remova esta linha se quiser rastreá-los.
*.gdoc
*.gsheet

# Snapshots de página salvos localmente (não são código-fonte)
view-source_*.html

# === Material de negócio/operação fora do escopo do repositório de código ===
# Decisão: este repositório é só código + documentação técnica.
# Planilhas de meta/bonificação, POPs em PDF/HTML, áudio, portfólio
# comercial e imagens soltas de marketing ficam no disco (Drive/backup
# próprio da operação), não no histórico do git. `Branding/` é exceção
# — é a fonte de packages/ui, entra normalmente. `plano-negocio-
# facaamigos.md` também é exceção — é documentação de projeto citada
# no plano de arquitetura.
/Agente Amigo/
/Controle/
/FAixas/
/Faça Amigos Circuito/
/Branding.zip
/Bonificação.jpeg
/Padrão de Venda.jpeg
/Preços.jpeg
/Logotipo.png
/FacaAmigos_POPs.pdf
/FacaAmigos_POPs (1).pdf
/PlanoAcao_FacaAmigos.pdf
/Portfolio Clinicas LEADS.pdf
/POP 01 — Operação e PDV — FaçaAmigos
/pop_01_impress_o_a4.html
/pop_02_impress_o_a4.html
/pop_03_impress_o_a4.html

.vercel
.env*
# Reafirma a exceção: a regra `.env*` acima é posterior ao `!.env.example`
# da seção "Env / secrets" e sozinha voltaria a ignorar os exemplos, que
# são justamente a documentação do que cada instalação precisa provisionar.
!.env.example
!**/.env.example
.voz/

# Config local de MCP: carrega token pessoal na URL — nunca versionar
.mcp.json
