{
  "name": "@facaamigos/kiosk",
  "private": true,
  "version": "0.1.210",
  "description": "Electron main + servidor Fastify local (D1/D2 do plano) — única gravadora do ponto, serve a SPA para o Electron e para os tablets da LAN.",
  "type": "module",
  "main": "./bundle/main.mjs",
  "scripts": {
    "dev:server": "tsx watch src/server/start.ts",
    "build": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "start:electron": "pnpm run bundle && electron .",
    "dist": "pnpm run bundle && electron-builder --win",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@facaamigos/contracts": "workspace:*",
    "@facaamigos/db-local": "workspace:*",
    "@facaamigos/domain": "workspace:*",
    "@facaamigos/fiscal": "workspace:*",
    "@fastify/cors": "^10.1.0",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@supabase/supabase-js": "^2.119.0",
    "@types/qrcode": "^1.5.6",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "fastify": "^5.12.8",
    "node-forge": "^1.4.3",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "ws": "^8.22.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@facaamigos/config": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/node-forge": "^1.3.14",
    "@types/ws": "^8.18.2",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "eslint": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
