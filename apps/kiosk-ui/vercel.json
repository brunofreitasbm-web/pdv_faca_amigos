{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../../packages ../../pnpm-lock.yaml",
  "headers": [
    {
      "source": "/(version.json|sw.js|index.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/integracao/shopping/v1/health",
      "destination": "/api/integracao/shopping/v1/health"
    },
    {
      "source": "/integracao/shopping/v1/faturamento",
      "destination": "/api/integracao/shopping/v1/faturamento"
    },
    {
      "source": "/integracao/shopping/v1/vendas",
      "destination": "/api/integracao/shopping/v1/vendas"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth?action=metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth?action=resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api/oauth?action=resource"
    },
    {
      "source": "/oauth/register",
      "destination": "/api/oauth?action=register"
    },
    {
      "source": "/oauth/authorize",
      "destination": "/api/oauth?action=authorize"
    },
    {
      "source": "/oauth/token",
      "destination": "/api/oauth?action=token"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
